{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "ignorePatterns": [
    "design",
    "design V2",
    "**/.svelte-kit",
    "**/build",
    "**/dist",
    "**/.wrangler"
  ],
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn"
  }
}
