{
  "name": "@rollwith/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rollwith-hd --local",
    "db:migrate:remote": "wrangler d1 migrations apply rollwith-hd --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@rollwith/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20250708.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "wrangler": "^4.154.0"
  }
}
