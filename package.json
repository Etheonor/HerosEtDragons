{
  "name": "rollwith-hd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "pnpm --filter web build && pnpm --filter web dev & pnpm --filter api dev",
    "build": "pnpm --filter shared build && pnpm --filter web build && pnpm --filter api build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm --filter shared typecheck && pnpm --filter ingest typecheck && pnpm --filter web check && pnpm --filter api typecheck && pnpm --filter api typecheck:test",
    "test": "vitest run && pnpm --filter api test",
    "portraits": "node tools/portraits/build.mjs",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:remote": "pnpm --filter api db:migrate:remote",
    "deploy": "pnpm build && wrangler deploy",
    "ingest": "pnpm --filter ingest ingest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "dev:seed": "curl -s -X POST -H 'Content-Type: application/json' -d '{\"reset\":true}' http://localhost:8787/api/dev/seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "oxfmt": "0.58.0",
    "oxlint": "^1.14.0",
    "sharp": "^0.35.4",
    "vitest": "^3.2.4",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@10.20.0"
}
